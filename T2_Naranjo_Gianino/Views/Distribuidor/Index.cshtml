@model IEnumerable<T2_Naranjo_Gianino.Models.Distribuidor>

<div class="container pt-3">

    <div class="row pt-4">

        <div class="col-6">
            <h2 class="text-primary">Lista de Distribuidores</h2>
        </div>

        <div class="col-6 text-end">
            <a asp-controller="Distribuidor"
               asp-action="Crear"
               class="btn btn-primary">

                Nuevo Distribuidor
            </a>

        </div>

    </div>

    <br />

    @if (Model.Count() > 0)
    {
        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Razón Social</th>
                    <th>Teléfono</th>
                    <th>Año Inicio</th>
                    <th>Contacto</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NombreDistribuidor</td>
                        <td>@item.RazonSocial</td>
                        <td>@item.Telefono</td>
                        <td>@item.AnioInicioOperacion</td>
                        <td>@item.Contacto</td>

                        <td>
                            <a asp-action="Editar"
                               asp-route-id="@item.Id"
                               class="btn btn-warning">

                                Editar
                            </a>

                            <a asp-action="Eliminar"
                               asp-route-id="@item.Id"
                               class="btn btn-danger">

                                Eliminar
                            </a>
                        </td>
                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <p>No hay registros.</p>
    }

</div>