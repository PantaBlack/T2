@model T2_Naranjo_Gianino.Models.Distribuidor

<h2>Nuevo Distribuidor</h2>

<form method="post" asp-action="Eliminar">

    <div class="mb-3">
        <label asp-for="NombreDistribuidor"></label>
        <input asp-for="NombreDistribuidor" class="form-control" />
        <span asp-validation-for="NombreDistribuidor" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RazonSocial"></label>
        <input asp-for="RazonSocial" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Telefono"></label>
        <input asp-for="Telefono" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="AnioInicioOperacion"></label>
        <input asp-for="AnioInicioOperacion" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Contacto"></label>
        <input asp-for="Contacto" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Regresar
    </a>

</form>
<input type="hidden" asp-for="Id" />

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}