@{
    ViewData["Title"] = "Distribuidores Perú";
}

<div class="container">

    <h1 class="text-primary">
        Distribuidores Reconocidos en el Perú
    </h1>

    <br />

    <p>
        En el Perú existen importantes empresas distribuidoras
        encargadas de abastecer productos alimenticios,
        tecnológicos y comerciales a nivel nacional.
    </p>

    <br />

    <h3>Grupo Gloria</h3>

    <img src="https://upload.wikimedia.org/wikipedia/commons/5/5f/Gloria_SA_logo.png"
         width="300" />

    <br />
    <br />

    <p>
        Gloria es una de las empresas más importantes del Perú
        dedicada a la producción y distribución de alimentos
        y productos lácteos.
    </p>

    <br />

    <h3>Alicorp</h3>

    <img src="https://upload.wikimedia.org/wikipedia/commons/7/73/Alicorp_logo.svg"
         width="300" />

    <br />
    <br />

    <p>
        Alicorp distribuye productos de consumo masivo
        dentro y fuera del Perú.
    </p>

    <br />

    <h3>Video Informativo</h3>

    <iframe width="560"
            height="315"
            src="https://www.youtube.com/embed/bNyUyrR0PHo"
            title="YouTube video player"
            frameborder="0"
            allowfullscreen>
    </iframe>

</div>